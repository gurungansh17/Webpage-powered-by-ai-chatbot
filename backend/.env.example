# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:3000
# Base URL for uploaded image links — set to your full deployed URL in production
BASE_URL=http://localhost:5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai-solutions?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Nodemailer (Gmail) ───────────────────────────────────────────────────────
# Use a Gmail account with an App Password (not your normal password)
# Instructions: Google Account → Security → 2FA → App Passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
ADMIN_EMAIL=admin@ai-solutions.com

# ─── Groq AI (Chatbot) ────────────────────────────────────────────────────────
# Get your free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ─── Google reCAPTCHA v2 ──────────────────────────────────────────────────────
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
